# colcon build artifacts
/build/
/install/
/log/

# source repos come via `vcs import src < stonefish.repos` — not tracked here
/src/

# omx run outputs (SSOT tree, data — not shared via git)
/experiments/

# omp SSOT sharing policy (chosen at omp-init 2026-06-23)
# Share rules.json + *.md with the team; wiki/ and work/ are personal/regenerable.
.omp/wiki/
.omp/work/
.omp/secretary/

# omx: share profile/ only; scratch/run artifacts stay local
.omx/*
!.omx/profile/

# session/tool state, scratch
.omc/
.sp/
.claude/
__pycache__/
.env
.omp/state/
# graphify knowledge-graph index (build artifact)
.graphify/

# per-machine MCP server config (absolute cwd) — not shared
.mcp.json

# .hq unified store (2026-08-31, .omp+.omx 통합) — work/runtime 은 재생성 가능
**/.hq/work/
**/.hq/runtime/
# hq 쓰기 락 (community/ 안에 생기지만 runtime 성격)
**/.hq/**/.hq-lock
