# colcon build artifacts
/build/
/install/
/log/

# source repos come via `vcs import src < stonefish.repos` — not tracked here
/src/

# omx run outputs (SSOT tree, data — not shared via git)
/experiments/

# 외부 수령 자산 (실해역 bag·학습 가중치·고아 런 출력) — 재생성 불가, 머신 로컬.
# experiments/ 와 갈리는 축은 출처다: experiments/=우리가 만든 omx 런 출력,
# data/=밖에서 받아온 것. 4.5GB bag 이 여기 있어 추적하면 안 된다.
/data/

# session/tool state, scratch
.omc/
.sp/
# .claude/ 는 머신 상태(settings.local.json)와 저작물이 섞여 있다.
# rules/ 만 연다 — CLAUDE.md 가 code-graph.md 를 '신뢰 규칙 정본'으로 링크하므로
# 추적하지 않으면 클론한 팀원에게는 끊긴 링크가 된다.
.claude/*
!.claude/rules/
__pycache__/
.env
# graphify knowledge-graph index (build artifact)
.graphify/

# per-machine MCP server config (absolute cwd) — not shared
.mcp.json

# .hq unified store (2026-08-31, .omp+.omx 통합) — store-spec §5 의 네 줄
**/.hq/work/
**/.hq/runtime/
# 루트-로컬 상태 락 디렉터리 — 세션이 락을 쥔 채 죽으면 빈 lockdir 이 남는다
**/.harness.lock/
# hq 쓰기 락 — community/(추적 층) 안에 생겨 위 두 줄로는 안 걸린다
**/.hq/**/.hq-lock

# omo vendor context loaders — omo `shared-context.md` 절차로 재생성되는 도구 설정.
# omo 버전에 결합돼 있어 추적하면 버전 drift 가 그대로 팀에 퍼진다.
.codex/
.agents/
